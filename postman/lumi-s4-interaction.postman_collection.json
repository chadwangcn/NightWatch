          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// /readyz 是内部接口，外部访问应返回 404",
                  "pm.test('readyz is internal-only (404 externally)', () => pm.response.to.have.status(404));"
                ]
              }
