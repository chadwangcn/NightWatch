                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('success=true', () => pm.expect(j.success).to.be.true);"
                ]
              }
            }
          ]
        }
      ]
    },
