                  "pm.test('transport=websocket', () => pm.expect(j.data.transport).to.eql('websocket'));",
                  "if (j.data && j.data.receiptRefs && j.data.receiptRefs.mediaSessionReceiptRef) {",
                  "  console.log('mediaSessionReceiptRef:', j.data.receiptRefs.mediaSessionReceiptRef);",
                  "}",
                  "if (j.data && j.data.connectDescriptor && j.data.connectDescriptor.indexOf('oneTimeToken=') !== -1) {",
                  "  const token = j.data.connectDescriptor.split('oneTimeToken=')[1].split('&')[0];",
                  "  pm.environment.set('s4_media_one_time_token', token);",
                  "}"
                ]
              }
            }
          ]
        }
