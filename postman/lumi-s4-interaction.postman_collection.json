    {
      "name": "01 · 设备面 · 语音消息",
      "description": "语音消息生命周期：session → turn → playback-receipt → directive:resolve → directive/events\n鉴权：device_access_token（来自 device-platform 集合）\n执行顺序：VM1 → VM2 → VM3 → VM4 → VM5",
      "item": [
        {
          "name": "VM1 POST /v1/ai/voice-message/session",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/v1/ai/voice-message/session",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{device_access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"traceId\": \"{{trace_id}}\",\n  \"sessionId\": \"sess-test-{{$timestamp}}\",\n  \"childId\": \"{{child_profile_id}}\",\n  \"deviceId\": \"{{device_sn}}\",\n  \"requestId\": \"{{request_id}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('trace_id', 'tr-' + Date.now() + '-' + Math.random().toString(36).slice(2,8));",
                  "pm.environment.set('request_id', 'req-' + Date.now() + '-' + Math.random().toString(36).slice(2,8));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('success=true', () => pm.expect(j.success).to.be.true);",
                  "if (j.data && j.data.voiceSessionId) {",
                  "  pm.environment.set('s4_voice_session_id', j.data.voiceSessionId);",
                  "  if (j.data.correlation && j.data.correlation.turnId) pm.environment.set('s4_voice_turn_id', j.data.correlation.turnId);",
                  "  console.log('voiceSessionId:', j.data.voiceSessionId);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "VM2 POST /v1/ai/voice-message/{voiceSessionId}/turn",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/v1/ai/voice-message/{{s4_voice_session_id}}/turn",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{device_access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contractVersion\": \"voice-message-turn-v1\",\n  \"traceId\": \"{{trace_id}}\",\n  \"sessionId\": \"sess-test-{{$timestamp}}\",\n  \"turnId\": \"turn-{{$timestamp}}\",\n  \"idempotencyKey\": \"{{idempotency_key}}\",\n  \"input\": {\n    \"type\": \"asr_final\",\n    \"asrFinal\": {\n      \"segmentId\": \"seg-001\",\n      \"text\": \"给我讲个小红帽的故事\",\n      \"languageTag\": \"zh-CN\",\n      \"confidence\": 0.95\n    }\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('trace_id', 'tr-' + Date.now() + '-' + Math.random().toString(36).slice(2,8));",
                  "pm.environment.set('idempotency_key', 'idem-' + Date.now() + '-' + Math.random().toString(36).slice(2,8));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('contractVersion=voice-message-turn-result-v1', () => pm.expect(j.data.contractVersion).to.eql('voice-message-turn-result-v1'));",
                  "if (j.data && j.data.correlation && j.data.correlation.turnId) pm.environment.set('s4_voice_turn_id', j.data.correlation.turnId);",
                  "if (j.data && j.data.outcome && j.data.outcome.assistantOutput && j.data.outcome.assistantOutput.speech && j.data.outcome.assistantOutput.speech.speechId) pm.environment.set('s4_speech_id', j.data.outcome.assistantOutput.speech.speechId);",
                  "if (j.data && j.data.outcome && j.data.outcome.actionDirective && j.data.outcome.actionDirective.directiveId) pm.environment.set('s4_directive_id', j.data.outcome.actionDirective.directiveId);"
                ]
              }
            }
          ]
        },
        {
          "name": "VM3 POST /v1/ai/voice-message/{voiceSessionId}/playback-receipt",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/v1/ai/voice-message/{{s4_voice_session_id}}/playback-receipt",
