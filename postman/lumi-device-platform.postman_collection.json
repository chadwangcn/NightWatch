              "  pm.test('code is AUTH_CREDENTIAL_INVALID', () => pm.expect(j.code).to.eql('AUTH_CREDENTIAL_INVALID'));",
              "  console.log('✅ 设备旧 token 已失效: ' + j.code);",
              "} catch(e) {}"
            ]}
          }]
        },
