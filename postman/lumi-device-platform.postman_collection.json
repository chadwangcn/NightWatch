              "const j = pm.response.json();",
              "pm.test('binding_version >= 1 (bound)', () => pm.expect(j.binding_version).to.be.at.least(1));",
              "console.log('✅ 设备引导确认: bv=' + j.binding_version);"
            ]}
          }]
        },
        {
          "name": "B5 · GET /v1/device-bindings/{device_sn} (User 查询绑定)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{user_access_token}}" }
            ],
            "url": {
