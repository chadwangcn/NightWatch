              "  pm.test('code is RESOURCE_ACCESS_DENIED', () => pm.expect(j.code).to.eql('RESOURCE_ACCESS_DENIED'));",
              "  console.log('✅ APP 查询已解绑设备返回 404 RESOURCE_ACCESS_DENIED');",
              "} catch(e) {}"
            ]}
          }]
