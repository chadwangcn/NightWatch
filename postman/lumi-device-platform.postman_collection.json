    {
      "name": "01 · APP单边 · 用户登录",
      "description": "场景：APP 用户登录。\n\n账号 + Argon2id 密码 → user_access_token (typ=lumi-user-access+jws, TTL 900s)。\n\n这是场景B(配对绑定)和场景C(解绑)的前置条件。",
      "item": [
        {
          "name": "POST /v1/user-sessions (login)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"account\": \"{{user_account}}\",\n  \"password\": \"{{user_password}}\"\n}" },
            "url": { "raw": "{{base_url}}/v1/user-sessions", "host": ["{{base_url}}"], "path": ["v1","user-sessions"] }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('user-sessions returns 201', () => pm.response.to.have.status(201));",
              "const j = pm.response.json();",
              "if (j.user_access_token) pm.environment.set('user_access_token', j.user_access_token);",
              "if (j.user_refresh_token) pm.environment.set('user_refresh_token', j.user_refresh_token);",
              "pm.test('expires_in is 900', () => pm.expect(j.expires_in).to.eql(900));",
              "console.log('✅ 用户登录成功，token 已写入环境变量');"
            ]}
          }]
        },
        {
          "name": "POST /v1/user-sessions:refresh",
          "request": {
