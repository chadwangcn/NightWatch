          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('logout returns 204', () => pm.response.to.have.status(204));"
            ]}
          }]
        }
      ]
    },
    {
      "name": "02 · 场景A · 设备首次激活",
      "description": "场景A：设备单边激活流程。\n\n前置：设备已产线导入（lifecycle_state=provisioned 或 active），持有出厂 device_secret。\n\n异常码：\n- proof 错 → 401 AUTH_CREDENTIAL_INVALID\n- 设备非 active/provisioned → 401 AUTH_CREDENTIAL_REVOKED\n- nonce 重放 → 409 AUTH_REPLAY_DETECTED\n- timestamp 超窗 (±300s) → 400 AUTH_REQUEST_INVALID",
      "item": [
        {
          "name": "A1 · POST /v1/device-sessions (Device Proof)",
          "event": [
            {
              "listen": "prerequest",
              "script": { "type": "text/javascript", "exec": [
                "// ===== 设备证明计算（规范见 docs/auth/device-proof.md） =====",
                "const CryptoJS = require('crypto-js');",
                "const productId = pm.environment.get('product_id');",
                "const deviceSn = pm.environment.get('device_sn');",
                "const credVer = String(pm.environment.get('credential_version'));",
                "const ts = Math.floor(Date.now()/1000).toString();",
                "const secretB64 = pm.environment.get('device_secret_b64url');",
                "// 生成 16 字节 base64url nonce (22 字符)",
                "const nonceBytes = CryptoJS.lib.WordArray.random(16);",
                "const nonce = nonceBytes.toString(CryptoJS.enc.Base64).replace(/\\+/g,'-').replace(/\\//g,'_').replace(/=+$/,'');",
                "pm.environment.set('device_timestamp', ts);",
                "pm.environment.set('device_nonce', nonce);",
                "const runtime = {",
                "  app_version: '1.2.1',",
                "  capability_digest: pm.environment.get('capability_digest'),",
                "  firmware_version: '1.0.0'",
                "};",
                "// JCS 规范化 body（去掉 device_proof，键按字典序）",
                "const bodyNoProof = {",
                "  credential_version: parseInt(credVer),",
                "  device_sn: deviceSn,",
                "  nonce: nonce,",
                "  product_id: productId,",
                "  runtime: runtime,",
                "  timestamp: parseInt(ts)",
                "};",
                "const bodyJson = JSON.stringify(bodyNoProof);",
                "const bodySha256 = CryptoJS.SHA256(bodyJson).toString(CryptoJS.enc.Hex);",
                "// Canonical Request (8 行, LF 分隔, 末尾无 LF)",
                "const canonical = ['K1_DEVICE_AUTH_V1','POST','/v1/device-sessions',",
                "  `product_id=${productId}`,`device_sn=${deviceSn}`,",
                "  `credential_version=${credVer}`,`timestamp=${ts}`,",
                "  `nonce=${nonce}`,`body_sha256=${bodySha256}`].join('\\n');",
                "// base64url 解码 device_secret",
                "const secretWords = CryptoJS.enc.Base64.parse(secretB64.replace(/-/g,'+').replace(/_/g,'/'));",
                "const proof = CryptoJS.HmacSHA256(canonical, secretWords).toString(CryptoJS.enc.Base64).replace(/\\+/g,'-').replace(/\\//g,'_').replace(/=+$/,'');",
                "pm.environment.set('device_proof', proof);",
                "pm.variables.set('req_body', JSON.stringify({",
                "  product_id: productId,",
                "  device_sn: deviceSn,",
                "  credential_version: parseInt(credVer),",
                "  timestamp: parseInt(ts),",
                "  nonce: nonce,",
                "  runtime: runtime,",
                "  device_proof: proof",
                "}));"
              ]}
            },
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "pm.test('device-sessions returns 201', () => pm.response.to.have.status(201));",
                "const j = pm.response.json();",
                "if (j.device_access_token) pm.environment.set('device_access_token', j.device_access_token);",
                "if (j.device_refresh_token) pm.environment.set('device_refresh_token', j.device_refresh_token);",
                "if (j.binding_version !== undefined) pm.environment.set('binding_version', String(j.binding_version));",
                "pm.test('expires_in is 900', () => pm.expect(j.expires_in).to.eql(900));",
                "console.log('✅ 设备激活成功，binding_version=' + j.binding_version);"
              ]}
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{{req_body}}" },
            "url": { "raw": "{{base_url}}/v1/device-sessions", "host": ["{{base_url}}"], "path": ["v1","device-sessions"] }
          }
        },
        {
          "name": "A2 · GET /v1/device-bootstrap",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{device_access_token}}" }
            ],
            "url": { "raw": "{{base_url}}/v1/device-bootstrap", "host": ["{{base_url}}"], "path": ["v1","device-bootstrap"] }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('bootstrap returns 200', () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test('has device_sn', () => pm.expect(j.device_sn).to.be.a('string'));",
              "pm.test('has binding_version', () => pm.expect(j.binding_version).to.be.a('number'));",
              "console.log('设备引导: bv=' + j.binding_version);"
            ]}
          }]
        }
      ]
    },
    {
      "name": "03 · 场景B · QR配对绑定",
      "description": "场景B：设备 ↔ APP 协同配对（核心互动场景）。\n\n执行顺序：\n  B1 → B2 → B3（重复直到 bv≥1）→ B4 → B5\n\n最新 API 变更（已对齐）：\n- B1: POST /v1/device-bindings:start-pairing（原 GET /v1/device-pairing-challenges 已废弃）\n- B5: GET /v1/device-bindings/{device_sn}（原 /current?device_sn= 已废弃）\n\n关键规则：\n- nonce 必须由服务端签发（B1）\n- timestamp 用 challenge 返回值，不用本地时钟\n- 绑定成功后设备旧 token 立即失效（bv 0→1）\n- B3 每次执行都重新计算 Device Proof（新 nonce）\n- 同一 pairing nonce 第二次使用 → 409 AUTH_REPLAY_DETECTED\n\n【单接口测试】\n- B1 依赖：device_access_token（来自 A1）\n- B2 依赖：user_access_token（来自 01.login）+ pairing_nonce/timestamp（来自 B1）\n- B3 依赖：device_secret_b64url（无 token 依赖，可独立 Send）\n- B4 依赖：device_access_token（来自 B3，bv≥1）\n- B5 依赖：user_access_token（来自 01.login）",
      "item": [
        {
          "name": "B1 · POST /v1/device-bindings:start-pairing (Device)",
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('start-pairing returns 201', () => pm.response.to.have.status(201));",
              "const j = pm.response.json();",
              "pm.environment.set('pairing_nonce', j.nonce);",
              "pm.environment.set('pairing_timestamp', String(j.timestamp));",
              "pm.test('nonce is 22 chars base64url', () => pm.expect(j.nonce).to.match(/^[A-Za-z0-9_-]{22}$/));",
              "pm.test('timestamp is positive int', () => pm.expect(j.timestamp).to.be.a('number').above(0));",
              "pm.test('device_sn matches', () => pm.expect(j.device_sn).to.eql(pm.environment.get('device_sn')));",
              "console.log('✅ 配对挑战已获取');",
              "console.log('   nonce=' + j.nonce);",
              "console.log('   timestamp=' + j.timestamp);"
            ]}
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{device_access_token}}" }
            ],
            "url": { "raw": "{{base_url}}/v1/device-bindings:start-pairing", "host": ["{{base_url}}"], "path": ["v1","device-bindings:start-pairing"] }
          }
        },
        {
          "name": "B2 · POST /v1/device-bindings (User 提交配对)",
          "event": [
            {
              "listen": "prerequest",
              "script": { "type": "text/javascript", "exec": [
                "// ===== 配对证明计算（规范见 docs/auth/pairing-proof.md） =====",
                "const CryptoJS = require('crypto-js');",
                "const deviceSn = pm.environment.get('device_sn');",
                "const ts = pm.environment.get('pairing_timestamp');",
                "const nonce = pm.environment.get('pairing_nonce');",
                "const secretB64 = pm.environment.get('device_secret_b64url');",
                "if (!nonce || !ts) {",
                "  console.warn('⚠️  缺少 pairing_nonce/pairing_timestamp，请先执行 B1');",
                "}",
                "// Canonical Request (6 行, LF 分隔, 末尾无 LF)",
                "const canonical = ['K1_PAIRING_V1','POST','/v1/device-bindings',",
                "  `device_sn=${deviceSn}`,`timestamp=${ts}`,`nonce=${nonce}`].join('\\n');",
                "const secretWords = CryptoJS.enc.Base64.parse(secretB64.replace(/-/g,'+').replace(/_/g,'/'));",
                "const proof = CryptoJS.HmacSHA256(canonical, secretWords).toString(CryptoJS.enc.Base64).replace(/\\+/g,'-').replace(/\\//g,'_').replace(/=+$/,'');",
                "pm.environment.set('pairing_proof', proof);",
                "console.log('Pairing proof 计算完成');"
              ]}
            },
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "pm.test('device-bindings returns 201', () => pm.response.to.have.status(201));",
                "const j = pm.response.json();",
                "pm.test('status is active', () => pm.expect(j.status).to.eql('active'));",
                "if (j.binding_version !== undefined) pm.environment.set('binding_version', String(j.binding_version));",
                "console.log('✅ 绑定成功，binding_version=' + j.binding_version);",
                "console.log('⚠️  设备旧 token 立即失效，请执行 B3 重新认证');"
              ]}
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{user_access_token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"device_sn\": \"{{device_sn}}\",\n  \"child_profile_id\": \"{{child_profile_id}}\",\n  \"pairing_proof\": \"{{pairing_proof}}\",\n  \"nonce\": \"{{pairing_nonce}}\",\n  \"timestamp\": {{pairing_timestamp}}\n}" },
            "url": { "raw": "{{base_url}}/v1/device-bindings", "host": ["{{base_url}}"], "path": ["v1","device-bindings"] }
          }
        },
        {
          "name": "B3 · POST /v1/device-sessions (设备重新认证, 发现 bv 0→1)",
          "event": [
            {
              "listen": "prerequest",
              "script": { "type": "text/javascript", "exec": [
                "// ===== 设备重新认证（绑定后旧 token 失效，必须重新执行 Device Proof） =====",
                "// 本请求可重复 Send，每次自动生成新 nonce 并重新计算 proof",
                "const CryptoJS = require('crypto-js');",
                "const productId = pm.environment.get('product_id');",
                "const deviceSn = pm.environment.get('device_sn');",
                "const credVer = String(pm.environment.get('credential_version'));",
                "const ts = Math.floor(Date.now()/1000).toString();",
                "const secretB64 = pm.environment.get('device_secret_b64url');",
                "const nonceBytes = CryptoJS.lib.WordArray.random(16);",
                "const nonce = nonceBytes.toString(CryptoJS.enc.Base64).replace(/\\+/g,'-').replace(/\\//g,'_').replace(/=+$/,'');",
                "const runtime = {",
                "  app_version: '1.2.1',",
                "  capability_digest: pm.environment.get('capability_digest'),",
                "  firmware_version: '1.0.0'",
                "};",
                "const bodyNoProof = {",
                "  credential_version: parseInt(credVer),",
                "  device_sn: deviceSn,",
                "  nonce: nonce,",
                "  product_id: productId,",
                "  runtime: runtime,",
                "  timestamp: parseInt(ts)",
                "};",
                "const bodyJson = JSON.stringify(bodyNoProof);",
                "const bodySha256 = CryptoJS.SHA256(bodyJson).toString(CryptoJS.enc.Hex);",
                "const canonical = ['K1_DEVICE_AUTH_V1','POST','/v1/device-sessions',",
                "  `product_id=${productId}`,`device_sn=${deviceSn}`,",
                "  `credential_version=${credVer}`,`timestamp=${ts}`,",
                "  `nonce=${nonce}`,`body_sha256=${bodySha256}`].join('\\n');",
                "const secretWords = CryptoJS.enc.Base64.parse(secretB64.replace(/-/g,'+').replace(/_/g,'/'));",
                "const proof = CryptoJS.HmacSHA256(canonical, secretWords).toString(CryptoJS.enc.Base64).replace(/\\+/g,'-').replace(/\\//g,'_').replace(/=+$/,'');",
                "pm.variables.set('req_body', JSON.stringify({",
                "  product_id: productId,",
                "  device_sn: deviceSn,",
                "  credential_version: parseInt(credVer),",
                "  timestamp: parseInt(ts),",
                "  nonce: nonce,",
                "  runtime: runtime,",
                "  device_proof: proof",
                "}));"
              ]}
            },
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "pm.test('device-sessions returns 201', () => pm.response.to.have.status(201));",
                "const j = pm.response.json();",
                "if (j.device_access_token) pm.environment.set('device_access_token', j.device_access_token);",
                "if (j.device_refresh_token) pm.environment.set('device_refresh_token', j.device_refresh_token);",
                "if (j.binding_version !== undefined) pm.environment.set('binding_version', String(j.binding_version));",
                "",
                "const bv = j.binding_version;",
                "if (bv >= 1) {",
                "  console.log('✅ 绑定已确认，设备进入 bound 状态 (bv=' + bv + ')');",
                "  console.log('   可继续执行 B4 / B5');",
                "  pm.test('binding_version >= 1', () => pm.expect(bv).to.be.at.least(1));",
                "} else {",
                "  console.log('⏳ 绑定尚未完成 (bv=0)，请先执行 B2 (APP 提交配对)');",
                "  console.log('   或重复 Send 本请求 (B3) 继续轮询');",
                "  pm.test('binding_version still 0', () => pm.expect(bv).to.eql(0));",
                "}"
              ]}
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{{req_body}}" },
            "url": { "raw": "{{base_url}}/v1/device-sessions", "host": ["{{base_url}}"], "path": ["v1","device-sessions"] }
          }
        },
        {
          "name": "B4 · GET /v1/device-bootstrap (确认绑定)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{device_access_token}}" }
