{
  "openapi": "3.0.3",
  "info": {
    "title": "Demo Catalog API",
    "version": "2.0.0",
    "description": "Synthetic catalog API used as a NightWatch WP-02 generation fixture (v2: endpoint removed, schema changed, endpoint added). All data is synthetic."
  },
  "servers": [{ "url": "{{demo_api_base_url}}" }],
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer" },
      "apiKeyHeader": { "type": "apiKey", "in": "header", "name": "X-Api-Key" }
    },
    "schemas": {
      "ReportRequest": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "title": { "type": "string", "maxLength": 128 }
        }
      }
    }
  },
  "paths": {
    "/v1/widgets": {
      "get": {
        "operationId": "listWidgets",
        "summary": "List widgets",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "minimum": 1, "maximum": 100 }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "enum": ["active", "archived"] }
          }
        ],
        "responses": {
          "200": {
            "description": "Widget page",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["items"],
                  "properties": { "items": { "type": "array" } }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" }
        }
      },
      "post": {
        "operationId": "createWidget",
        "summary": "Create a widget",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "kind", "region"],
                "properties": {
                  "name": { "type": "string", "maxLength": 64 },
                  "quantity": { "type": "integer", "minimum": 0, "maximum": 1000 },
                  "kind": { "type": "string", "enum": ["standard", "premium"] },
                  "region": { "type": "string", "enum": ["cn", "eu"] }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created widget",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["id"],
                  "properties": { "id": { "type": "string" } }
                }
              }
            }
          },
          "400": { "description": "Invalid body" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/v1/widgets/{widgetId}": {
      "get": {
        "operationId": "getWidget",
        "summary": "Read one widget",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "widgetId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Widget",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["id", "name"],
                  "properties": {
                    "id": { "type": "string" },
                    "name": { "type": "string" }
                  }
                }
              }
            }
          },
          "404": { "description": "Not found" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/v1/widgets/{widgetId}/tags": {
      "get": {
        "operationId": "listWidgetTags",
        "summary": "List widget tags (added in v2)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "widgetId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Tag list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["tags"],
                  "properties": { "tags": { "type": "array" } }
                }
              }
            }
          },
          "404": { "description": "Not found" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/v1/health": {
      "get": {
        "operationId": "healthCheck",
        "summary": "Liveness probe",
        "security": [],
        "responses": {
          "200": { "description": "Healthy" }
        }
      }
    },
    "/v1/reports": {
      "post": {
        "operationId": "createReport",
        "summary": "Create a background report",
        "security": [{ "apiKeyHeader": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ReportRequest" }
            }
          }
        },
        "responses": {
          "202": { "description": "Accepted" },
          "400": { "description": "Invalid body" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/v1/metrics": {
      "post": {
        "operationId": "submitMetrics",
        "summary": "Submit metrics",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["source"],
                "properties": {
                  "source": { "type": "string", "maxLength": 32 }
                }
              }
            }
          }
        },
        "responses": {
          "202": { "description": "Accepted" },
          "401": { "description": "Unauthorized" }
        }
      }
    }
  }
}
