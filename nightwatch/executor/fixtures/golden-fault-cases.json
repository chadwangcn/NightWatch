      "assertions": [
        "@1 status_code equals 201",
        "@1 json $.id present",
        "@2 status_code equals 200",
        "@2 json $.name equals nw-golden-widget",
        "@3 status_code equals 204"
      ],
      "expect": "passed"
    },
    {
      "key": "c6",
      "title": "slow boundary responds within tolerance",
      "risk": "low",
      "type": "boundary",
      "steps": [{ "request": { "method": "GET", "path": "/v1/edge/slow?ms=2500" } }],
      "assertions": ["status_code equals 200", "response_time_ms below 6000"],
      "expect": "passed"
    },
    {
      "key": "c7",
      "title": "large response boundary parses completely",
      "risk": "low",
      "type": "boundary",
      "steps": [{ "request": { "method": "GET", "path": "/v1/edge/large" } }],
      "assertions": ["status_code equals 200", "json $.count equals 1000", "json $.items is array"],
      "expect": "passed"
