      "key": "c1",
      "title": "positive endpoint returns ok",
      "risk": "low",
      "type": "functional",
      "steps": [{ "request": { "method": "GET", "path": "/v1/positive" } }],
      "assertions": ["status_code in [200]", "json $.ok equals true", "json $.value equals 42"],
      "expect": "passed"
