{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nightwatch.local/schemas/scenario/v1.json",
  "title": "NightWatch Scenario",
  "description": "Reusable business or fault path across one or more endpoints (§5.6). Carries a revision (referenced by run manifests) and optional assumptions with confirmation status (§14).",
  "x-nightwatch-object": "scenario",
  "x-nightwatch-version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["scenario_id", "name", "description", "endpoints", "revision"],
  "properties": {
    "scenario_id": {"$ref": "https://nightwatch.local/schemas/common.json#/$defs/id_scen"},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "endpoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["api_id", "method", "path"],
        "properties": {
          "api_id": {"type": "string", "minLength": 1},
          "method": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1}
        }
      }
    },
    "case_ids": {
      "type": "array",
      "items": {"$ref": "https://nightwatch.local/schemas/common.json#/$defs/id_case"}
    },
    "revision": {
      "type": "string",
      "minLength": 1,
      "description": "User scenario revision identifier."
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assumption_id", "statement", "status"],
        "properties": {
          "assumption_id": {"type": "string", "minLength": 1},
          "statement": {"type": "string", "minLength": 1},
          "status": {"enum": ["confirmed", "unconfirmed"]}
        }
      }
    }
  }
}
