{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nightwatch.local/schemas/events/runStepRecorded/v1.json",
  "title": "Event: runStepRecorded",
  "description": "Notification that one execution step (workflow step / case execution) inside a run was recorded, with status and output checksum.",
  "x-nightwatch-object": "event_runStepRecorded",
  "x-nightwatch-version": "1.0.0",
  "x-nightwatch-event": "runStepRecorded",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "object_id", "object_type", "occurred_at", "sequence", "payload"],
  "properties": {
    "event_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "object_id": {"$ref": "https://nightwatch.local/schemas/common.json#/$defs/id_run"},
    "object_type": {"const": "run"},
    "occurred_at": {"$ref": "https://nightwatch.local/schemas/common.json#/$defs/iso8601_utc"},
    "sequence": {"type": "integer", "minimum": 1},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step", "step_index", "status"],
      "properties": {
        "step": {"type": "string", "minLength": 1},
        "step_index": {"type": "integer", "minimum": 0},
        "status": {"$ref": "https://nightwatch.local/schemas/common.json#/$defs/per_case_result"},
        "output_checksum": {"$ref": "https://nightwatch.local/schemas/common.json#/$defs/checksum"}
      }
    }
  }
}
