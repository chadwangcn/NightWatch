{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nightwatch.local/schemas/issue_draft/v1.json",
  "title": "NightWatch Issue Draft",
  "description": "Structured issue draft mirroring the §16 GitHub issue template: summary, environment, preconditions, minimal reproduction, expected, actual, reproducibility, timing, sanitized evidence, artifacts, scope boundary. Unverifiable internal causes may only appear in 'hypothesis' and must stay separated from confirmed external symptoms (§14.1).",
  "x-nightwatch-object": "issue_draft",
  "x-nightwatch-version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "draft_id",
    "finding_id",
    "summary",
    "environment",
    "preconditions",
    "minimal_reproduction",
    "expected",
    "actual",
    "reproducibility",
    "timing",
    "sanitized_evidence",
    "artifacts",
    "scope_boundary"
  ],
  "properties": {
    "draft_id": {"$ref": "https://nightwatch.local/schemas/common.json#/$defs/id_draft"},
    "finding_id": {"$ref": "https://nightwatch.local/schemas/common.json#/$defs/id_find"},
    "summary": {
      "type": "string",
      "minLength": 1,
      "description": "One sentence describing the externally visible problem and its impact."
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api_id", "environment_name", "spec_revision", "first_observed_at"],
      "properties": {
        "api_id": {"type": "string", "minLength": 1},
        "environment_name": {"type": "string", "minLength": 1},
        "spec_revision": {"type": "string", "minLength": 1},
        "first_observed_at": {"$ref": "https://nightwatch.local/schemas/common.json#/$defs/iso8601_utc"}
      }
    },
    "preconditions": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "minimal_reproduction": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "description": "Minimal reproduction steps."
    },
    "expected": {"type": "string", "minLength": 1},
    "actual": {"type": "string", "minLength": 1},
    "hypothesis": {
      "type": "string",
      "default": "",
      "description": "Optional suspected cause, explicitly marked as hypothesis; never stated as fact."
    },
    "reproducibility": {"$ref": "https://nightwatch.local/schemas/common.json#/$defs/reproducibility"},
    "timing": {
      "type": "string",
      "minLength": 1,
      "description": "Key timeline and concurrency deviations."
    },
    "sanitized_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "description": "Sanitized request/response/log summaries (redacted before entering any workspace)."
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "ref"],
        "properties": {
          "kind": {"enum": ["run", "manifest", "timeline", "report", "other"]},
          "ref": {"type": "string", "minLength": 1}
        }
      },
      "description": "Run ID, manifest, timeline and report references."
    },
    "scope_boundary": {
      "type": "string",
      "minLength": 1,
      "description": "E.g. NightWatch did not modify business code; root cause marked as suspected or unknown."
    },
    "labels": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "description": "Suggested labels per §16 (nightwatch, api, severity:*, finding:*, needs-fix, retest-pending)."
    }
  }
}
