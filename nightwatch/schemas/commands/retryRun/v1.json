{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nightwatch.local/schemas/commands/retryRun/v1.json",
  "title": "Command: retryRun",
  "description": "C02→C03 command retrying a (failed/timed-out) run. A retry creates a NEW run object referencing the original as its parent (run objects are immutable; revision = new object + parent reference, WorkRequest §5.5).",
  "x-nightwatch-object": "command_retryRun",
  "x-nightwatch-version": "1.0.0",
  "x-nightwatch-command": "retryRun",
  "type": "object",
  "additionalProperties": false,
  "required": ["command_id", "issued_at", "deadline", "payload"],
  "properties": {
    "command_id": {"$ref": "https://nightwatch.local/schemas/common.json#/$defs/idempotency_key"},
    "issued_at": {"$ref": "https://nightwatch.local/schemas/common.json#/$defs/iso8601_utc"},
    "deadline": {"$ref": "https://nightwatch.local/schemas/common.json#/$defs/iso8601_utc"},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id"],
      "properties": {
        "run_id": {
          "allOf": [{"$ref": "https://nightwatch.local/schemas/common.json#/$defs/id_run"}],
          "description": "The run to retry; the retry run will reference it as supersedes_run_id."
        },
        "reason": {"type": "string", "minLength": 1}
      }
    }
  }
}
